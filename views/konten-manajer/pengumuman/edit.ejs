<%- include('../../partials/headers/__header-dashboard.ejs', { title: 'Edit Pengumuman' }) %>
<%- include('../../partials/navs/__nav-manajer.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Edit Pengumuman</h4>
                        <form action="/manajer/pengumuman/update/<%= pengumuman.id %>" method="POST" enctype="multipart/form-data" data-loading>
                            <div class="form-group">
                                <label for="judul_pengumuman">Judul Pengumuman</label>
                                <input type="text" class="form-control" id="judul_pengumuman" name="judul" placeholder="Masukkan judul pengumuman" value="<%= (pengumuman && pengumuman.judul) || '' %>" required>
                            </div>

                            <div class="form-group">
                                <label for="isi_pengumuman">Isi Pengumuman</label>
                                <textarea class="form-control" id="isi_pengumuman" name="isi" rows="6" placeholder="Masukkan isi pengumuman" required><%= (pengumuman && pengumuman.isi) || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="foto_pengumuman">Ganti Foto Pengumuman</label>
                                <input type="file" class="form-control" id="foto_pengumuman" name="foto" accept="image/*" data-preview="previewEdit">
                                <small class="form-text text-muted">Format diperbolehkan: jpg, jpeg, png, webp dan Dimensi gambar harus 3240x1272 pixel</small>
                                <% if (pengumuman && pengumuman.foto) { %>
                                    <div class="mt-2" style="position: relative; display: inline-block;">
                                        <img id="previewEdit" src="/images/pengumuman/<%= pengumuman.foto %>" data-src="/images/pengumuman/<%= pengumuman.foto %>" alt="foto pengumuman" style="width:auto;max-width:100%;max-height:300px;height:auto;border-radius:8px;object-fit:contain;cursor:zoom-in;background:#f4f6fb;margin-left:0;margin-right:0;" class="img-click-preview">
                                        <button type="button" class="image-preview-remove existing-foto-remove" aria-label="Hapus gambar">
                                            <i class="mdi mdi-close"></i>
                                        </button>
                                        <input type="hidden" name="hapus_foto" value="" id="hapusFotoInput">
                                    </div>
                                <% } else { %>
                                    <div class="mt-2">
                                        <img id="previewEdit" src="/images/no-image.png" data-src="/images/no-image.png" alt="foto pengumuman" style="width:auto;max-width:100%;max-height:300px;height:auto;border-radius:8px;object-fit:contain;cursor:zoom-in;background:#f4f6fb;margin-left:0;margin-right:0;display:none;" class="img-click-preview">
                                    </div>
                                <% } %>
                            </div>

                            <div class="d-flex">
                                <button type="submit" class="btn btn-primary mr-2">Simpan</button>
                                <a href="/manajer/pengumuman" class="btn btn-light" data-loading>Kembali</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar modal-top" id="globalImagePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pratinjau Gambar</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <img id="globalImagePreviewEl" src="" alt="preview" style="width:100%;height:auto;display:block;">
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/scripts/__script-dashboard.ejs') %>
